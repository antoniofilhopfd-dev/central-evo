# Ambiente da aplicação: production | homolog
APP_ENV=homolog

PORT=3001

# Produção (na VPS: banco separado do de homologação)
DATABASE_URL_PRODUCTION=postgresql://central_evo:central_evo_dev@localhost:5432/central_evo_dev

# Homologação
DATABASE_URL_HOMOLOG=postgresql://central_evo:central_evo_dev@localhost:5432/central_evo_homolog

# Integração com Google Calendário (opcional — deixe em branco se não for usar)
# Crie em https://console.cloud.google.com/apis/credentials (OAuth Client ID, tipo "App da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve ser exatamente igual ao "URI de redirecionamento autorizado" cadastrado no Google:
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google-calendar/callback
