# Exemplo de configuração Nginx para a Hostinger VPS.
# Frontend estático + proxy reverso para a API Node (porta 3001).
server {
    listen 80;
    server_name central.seudominio.com.br;

    root /var/www/central-evo/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Depois de emitir o certificado (ex.: certbot), adicionar bloco 443 com SSL
# e redirecionar a porta 80 para 443.
